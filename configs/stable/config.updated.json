{
  "patches-version": "stable",
  "enable-module-update": true,
  "BraveBrowser-Nightly-Morphe-Dh6k": {
    "enable-module-update": true,
    "cli-type": "morphe",
    "enabled": true,
    "app-name": "Brave Browser",
    "patch-brand": "Dh6k",
    "sub-variant": "Nightly",
    "version": "beta",
    "arch": "arm64-v8a x86_64 armeabi-v7a x86",
    "pkg-name": "com.brave.browser_nightly",
    "patches-source": "dh6k/morphe-patches",
    "patcher-args": "--continue-on-error",
    "github-dlurl": "https://github.com/brave/brave-browser/releases",
    "github-asset-regex": "arm64-v8a: BraveMonoarm64\\.apk$ | armeabi-v7a: BraveMonoarm\\.apk$ | x86_64: BraveMonox64\\.apk$ | x86: BraveMonox86\\.apk$",
    "github-release-name-regex": "^Nightly v"
  },
  "PrimeVideo-Morphe-Hoodles-Experimental": {
    "enable-module-update": true,
    "patches-source": "hoo-dles/morphe-patches",
    "patch-brand": "Hoodles",
    "cli-type": "morphe",
    "enabled": true,
    "app-name": "Prime Video",
    "sub-variant": "Experimental",
    "pkg-name": "com.amazon.avod.thirdpartyclient",
    "version": "latest",
    "skip-patch-app-check": true,
    "arch": "arm64-v8a armeabi-v7a",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/amazon-mobile-llc/amazon-prime-video",
    "uptodown-dlurl": "https://amazon-video.en.uptodown.com/android"
  },
  "PrimeVideo-Morphe-Hoodles-Shared-Experimental": {
    "enable-module-update": true,
    "patches-source": "hoo-dles/morphe-patches",
    "patch-brand": "Hoodles",
    "cli-type": "morphe",
    "enabled": true,
    "app-name": "Prime Video",
    "variant": "Shared",
    "sub-variant": "Experimental",
    "pkg-name": "com.amazon.avod.thirdpartyclient",
    "version": "latest",
    "skip-patch-app-check": true,
    "arch": "arm64-v8a armeabi-v7a",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/amazon-mobile-llc/amazon-prime-video",
    "uptodown-dlurl": "https://amazon-video.en.uptodown.com/android",
    "excluded-patches": "'Rename Shared Permissions'"
  }
